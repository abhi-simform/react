{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && node scripts/build-headers.mjs && node scripts/build-sw.mjs",
    "dev": "react-router dev",
    "start": "node scripts/serve-spa.mjs",
    "preview": "npm run build && npm start",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "lint": "eslint app e2e --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "analyze": "ANALYZE=1 react-router build && node scripts/perf/deps.mjs --check",
    "perf:budget": "node scripts/perf/js-budget.mjs --check",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "headers:vercel": "node scripts/build-headers.mjs --vercel",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs",
    "verify:sentry": "node scripts/verify-sentry.mjs",
    "check:console": "node scripts/console-check.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "node scripts/install-hooks.mjs || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@sentry/react": "^11.10.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.23",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.5.11",
    "isbot": "^5",
    "lucide-react": "^1.52.0",
    "motion": "^14.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-router": "8.4.0",
    "shadcn": "^4.21.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/runtime": "^7.29.10",
    "@eslint/js": "^10.0.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.4.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@sentry/vite-plugin": "^11.10.0",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ]
  }
}
