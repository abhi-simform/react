# Copy to .env:  cp .env.example .env
NODE_ENV=development
PORT=4000

# Mongo runs in Docker (see ../docker-compose.yml). replicaSet=rs0 enables transactions.
MONGODB_URI=mongodb://localhost:27017/shopsphere?replicaSet=rs0

# Comma-separated list of frontend origins allowed to call the API (with cookies).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# URL the emails link to (verify email / reset password pages in the customer app).
CLIENT_URL=http://localhost:5173

# --- Auth ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-0123456789
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cookie flags. In production over HTTPS with a different frontend domain use SameSite=none.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Leave empty (host-only cookie). `.example.com` only if another subdomain must read the refresh cookie (14.2).
COOKIE_DOMAIN=

# --- Google sign-in (B10) ------------------------------------------------
# Leave empty to use the built-in MOCK Google (local consent page, non-production only).
# Real credentials: see backend/docs/API-CONVENTIONS.md "Google sign-in (B10)".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# auto = mock only while the credentials above are empty; true/false force it (ignored in production)
GOOGLE_MOCK=auto

# --- Email (Mailpit from docker compose: inbox at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="ShopSphere <no-reply@shopsphere.local>"
# A real provider needs a login (leave empty for Mailpit). Port 465 = SMTP_SECURE=true; 587 = false (14.2).
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Image uploads (local disk; files are served from /uploads) ----------
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=2097152

# --- Cache, rate-limit store and job queue (B12) -------------------------
# Leave REDIS_URL empty to run everything in-process (fine for one instance and local dev).
# With Redis (docker compose --profile cache up -d):  REDIS_URL=redis://localhost:6379
REDIS_URL=
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30
JOBS_ENABLED=true
ORDER_EXPIRY_MINUTES=30
ORDER_EXPIRY_SWEEP_SECONDS=60

# --- Logging ------------------------------------------------------------
LOG_LEVEL=debug

# --- Payments (B6) ---------------------------------------------------------
# Leave the Razorpay values empty to use the built-in MOCK gateway (non-production only).
# Real TEST mode: Razorpay Dashboard (Test mode) > Account & Settings > API Keys > Generate Test Key,
# and Webhooks > add a webhook (events payment.captured, payment.failed, refund.processed) with a secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# auto = mock only while the keys above are empty; true/false force it (ignored in production)
PAYMENT_MOCK=auto
MOCK_WEBHOOK_DELAY_MS=1500

# --- Later phases (leave empty for now) ---------------------------------
# REDIS_URL=redis://localhost:6379

# --- Production (14.2). With NODE_ENV=production the API refuses to start unless: COOKIE_SECURE=true, a random
# JWT_ACCESS_SECRET (not this file's placeholder), explicit https CORS_ORIGINS / CLIENT_URL. See ../DEPLOY.md.
# Seeding a non-local database needs SEED_PASSWORD (12+ characters); `db:reset` needs --i-know-this-wipes-the-database.
