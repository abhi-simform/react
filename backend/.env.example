# Copy to .env:  cp .env.example .env
NODE_ENV=development
PORT=4000

# Mongo runs in Docker (see ../docker-compose.yml). replicaSet=rs0 enables transactions.
MONGODB_URI=mongodb://localhost:27017/shopsphere?replicaSet=rs0

# Comma-separated list of frontend origins allowed to call the API (with cookies).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# URL the emails link to (verify email / reset password pages in the customer app).
CLIENT_URL=http://localhost:5173

# --- Auth ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-0123456789
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cookie flags. In production over HTTPS with a different frontend domain use SameSite=none.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# --- Email (Mailpit from docker compose: inbox at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="ShopSphere <no-reply@shopsphere.local>"

# --- Logging ------------------------------------------------------------
LOG_LEVEL=debug

# --- Later phases (leave empty for now) ---------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# REDIS_URL=redis://localhost:6379
